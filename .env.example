# Vercel Postgres Connection String (Automatically populated when you connect
# a Vercel Postgres / Neon Database in the Vercel Dashboard)
# Format: postgres://[user]:[password]@[neon-host]/[dbname]?sslmode=require
POSTGRES_URL="postgres://default:your_password@ep-sample-pooler.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require"
POSTGRES_PRISMA_URL="postgres://default:your_password@ep-sample-pooler.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://default:your_password@ep-sample.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require"
DATABASE_URL="postgres://default:your_password@ep-sample-pooler.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require"

